# =====================================================================
# Plantilla de variables de entorno. Copiar a .env y completar valores.
#   cp .env.example .env
# =====================================================================

# ---- Frontend (Vite expone SOLO variables con prefijo VITE_) ----
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# ---- Administracion / provisioning (NO usar en frontend) ----
# Necesarias solo para scripts de deploy/migraciones locales o CI.
# NUNCA prefijar con VITE_ ni exponer en el cliente.
SUPABASE_PROJECT_REF=tu-project-ref
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VERCEL_TOKEN=vcp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
